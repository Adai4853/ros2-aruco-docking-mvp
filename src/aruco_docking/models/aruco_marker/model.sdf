<?xml version="1.0"?>
<sdf version="1.6">
  <model name="aruco_marker">
    <static>true</static>
    <link name="marker_link">
      <visual name="marker_visual">
        <geometry>
          <plane>
            <normal>-1 0 0</normal>
            <size>0.15 0.15</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_marker/materials/scripts</uri>
            <uri>model://aruco_marker/materials/textures</uri>
            <name>ArUco/Marker</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
